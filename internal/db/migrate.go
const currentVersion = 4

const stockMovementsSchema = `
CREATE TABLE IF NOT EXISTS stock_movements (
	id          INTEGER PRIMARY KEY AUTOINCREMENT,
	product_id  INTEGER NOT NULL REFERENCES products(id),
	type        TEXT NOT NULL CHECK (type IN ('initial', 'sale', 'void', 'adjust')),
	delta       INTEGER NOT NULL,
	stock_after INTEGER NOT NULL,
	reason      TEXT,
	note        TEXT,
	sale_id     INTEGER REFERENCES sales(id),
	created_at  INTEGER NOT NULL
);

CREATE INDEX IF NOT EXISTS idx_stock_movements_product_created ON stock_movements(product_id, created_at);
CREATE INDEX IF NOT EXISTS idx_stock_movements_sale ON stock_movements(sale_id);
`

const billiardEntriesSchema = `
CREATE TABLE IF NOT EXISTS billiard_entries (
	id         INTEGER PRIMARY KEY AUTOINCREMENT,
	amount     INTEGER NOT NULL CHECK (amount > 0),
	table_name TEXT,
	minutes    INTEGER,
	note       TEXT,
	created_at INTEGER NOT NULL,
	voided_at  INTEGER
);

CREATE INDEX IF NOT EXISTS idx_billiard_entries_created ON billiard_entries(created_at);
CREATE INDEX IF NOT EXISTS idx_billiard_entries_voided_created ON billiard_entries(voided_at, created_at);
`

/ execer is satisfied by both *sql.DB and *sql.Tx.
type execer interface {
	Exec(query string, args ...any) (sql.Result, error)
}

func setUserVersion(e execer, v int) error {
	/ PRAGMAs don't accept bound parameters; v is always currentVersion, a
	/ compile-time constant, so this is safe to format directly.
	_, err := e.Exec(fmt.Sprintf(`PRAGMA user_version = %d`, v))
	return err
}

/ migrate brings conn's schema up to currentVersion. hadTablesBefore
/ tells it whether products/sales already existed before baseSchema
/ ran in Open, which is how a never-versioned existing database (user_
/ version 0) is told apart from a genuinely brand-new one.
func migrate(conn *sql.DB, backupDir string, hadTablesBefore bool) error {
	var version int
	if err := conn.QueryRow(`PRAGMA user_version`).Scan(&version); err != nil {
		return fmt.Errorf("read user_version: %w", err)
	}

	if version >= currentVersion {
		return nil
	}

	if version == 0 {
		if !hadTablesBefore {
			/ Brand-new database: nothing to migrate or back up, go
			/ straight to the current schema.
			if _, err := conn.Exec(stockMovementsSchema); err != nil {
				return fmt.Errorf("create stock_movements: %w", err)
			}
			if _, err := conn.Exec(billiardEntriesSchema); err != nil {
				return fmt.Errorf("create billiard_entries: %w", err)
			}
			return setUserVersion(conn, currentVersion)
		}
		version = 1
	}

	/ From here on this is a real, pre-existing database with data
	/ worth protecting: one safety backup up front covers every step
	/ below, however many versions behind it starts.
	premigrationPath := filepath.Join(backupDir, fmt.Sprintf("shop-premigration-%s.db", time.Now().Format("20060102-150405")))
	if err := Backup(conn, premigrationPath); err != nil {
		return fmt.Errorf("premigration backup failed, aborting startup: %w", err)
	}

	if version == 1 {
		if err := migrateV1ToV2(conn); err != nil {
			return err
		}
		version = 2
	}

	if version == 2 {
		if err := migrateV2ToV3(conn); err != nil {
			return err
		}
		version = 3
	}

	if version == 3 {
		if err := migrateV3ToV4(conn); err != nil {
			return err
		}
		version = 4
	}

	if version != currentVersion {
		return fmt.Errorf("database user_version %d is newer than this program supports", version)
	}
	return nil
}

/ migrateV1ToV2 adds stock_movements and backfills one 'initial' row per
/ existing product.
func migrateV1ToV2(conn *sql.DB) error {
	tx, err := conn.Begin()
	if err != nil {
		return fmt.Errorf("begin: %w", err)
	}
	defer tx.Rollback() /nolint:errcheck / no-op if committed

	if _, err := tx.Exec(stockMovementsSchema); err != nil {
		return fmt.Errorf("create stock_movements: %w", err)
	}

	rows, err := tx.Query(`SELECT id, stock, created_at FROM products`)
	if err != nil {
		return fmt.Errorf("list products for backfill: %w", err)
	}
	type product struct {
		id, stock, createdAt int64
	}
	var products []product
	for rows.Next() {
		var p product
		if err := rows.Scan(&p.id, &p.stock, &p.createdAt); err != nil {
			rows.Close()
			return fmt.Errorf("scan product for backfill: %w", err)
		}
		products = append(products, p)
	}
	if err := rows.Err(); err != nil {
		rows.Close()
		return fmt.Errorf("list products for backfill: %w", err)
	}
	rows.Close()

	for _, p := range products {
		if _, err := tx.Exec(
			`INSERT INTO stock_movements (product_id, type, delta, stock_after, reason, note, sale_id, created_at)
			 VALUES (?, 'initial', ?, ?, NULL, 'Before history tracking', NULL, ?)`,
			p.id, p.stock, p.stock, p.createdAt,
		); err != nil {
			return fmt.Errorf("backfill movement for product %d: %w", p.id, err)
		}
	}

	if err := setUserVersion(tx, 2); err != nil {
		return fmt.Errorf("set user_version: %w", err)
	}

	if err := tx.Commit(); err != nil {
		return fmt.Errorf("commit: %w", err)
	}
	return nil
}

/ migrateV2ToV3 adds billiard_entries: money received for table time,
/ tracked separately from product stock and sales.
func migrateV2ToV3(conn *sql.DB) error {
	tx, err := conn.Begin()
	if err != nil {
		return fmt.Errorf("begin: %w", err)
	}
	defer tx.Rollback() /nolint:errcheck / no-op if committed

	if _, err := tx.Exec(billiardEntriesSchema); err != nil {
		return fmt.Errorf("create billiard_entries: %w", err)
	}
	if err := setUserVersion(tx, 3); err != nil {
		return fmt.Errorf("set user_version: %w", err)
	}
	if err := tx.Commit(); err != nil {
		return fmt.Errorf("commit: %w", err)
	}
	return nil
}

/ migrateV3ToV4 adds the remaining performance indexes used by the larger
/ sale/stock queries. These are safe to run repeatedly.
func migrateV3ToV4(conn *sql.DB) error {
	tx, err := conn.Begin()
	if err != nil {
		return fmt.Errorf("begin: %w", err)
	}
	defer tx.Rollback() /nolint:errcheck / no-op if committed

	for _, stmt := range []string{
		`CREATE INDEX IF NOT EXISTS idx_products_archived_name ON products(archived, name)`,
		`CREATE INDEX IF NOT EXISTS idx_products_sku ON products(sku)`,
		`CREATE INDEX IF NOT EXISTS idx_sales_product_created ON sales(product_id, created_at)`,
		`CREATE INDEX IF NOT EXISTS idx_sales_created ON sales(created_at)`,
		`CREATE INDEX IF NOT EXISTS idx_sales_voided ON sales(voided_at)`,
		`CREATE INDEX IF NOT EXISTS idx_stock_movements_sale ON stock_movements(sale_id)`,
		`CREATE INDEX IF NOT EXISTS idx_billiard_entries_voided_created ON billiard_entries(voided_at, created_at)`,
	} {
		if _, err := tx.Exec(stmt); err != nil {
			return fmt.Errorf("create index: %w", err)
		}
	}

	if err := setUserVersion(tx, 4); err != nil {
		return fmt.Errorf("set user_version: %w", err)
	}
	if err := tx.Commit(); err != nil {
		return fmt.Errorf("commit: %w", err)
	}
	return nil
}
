// Package db opens the SQLite database and sets up its schema.
package db

import (
	"database/sql"
	"fmt"

	_ "modernc.org/sqlite" // registers the "sqlite" driver
)

const baseSchema = `
CREATE TABLE IF NOT EXISTS products (
	id                  INTEGER PRIMARY KEY AUTOINCREMENT,
	name                TEXT NOT NULL,
	sku                 TEXT UNIQUE, -- NULL (not "") so multiple products can have no SKU
	price               INTEGER NOT NULL CHECK (price >= 0),
	stock               INTEGER NOT NULL DEFAULT 0 CHECK (stock >= 0),
	low_stock_threshold INTEGER NOT NULL DEFAULT 5,
	archived            INTEGER NOT NULL DEFAULT 0,
	created_at          INTEGER NOT NULL,
	updated_at          INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_products_archived_name ON products(archived, name);
CREATE INDEX IF NOT EXISTS idx_products_sku ON products(sku);

CREATE TABLE IF NOT EXISTS sales (
	id           INTEGER PRIMARY KEY AUTOINCREMENT,
	product_id   INTEGER NOT NULL REFERENCES products(id),
	product_name TEXT NOT NULL,
	quantity     INTEGER NOT NULL CHECK (quantity > 0),
	unit_price   INTEGER NOT NULL,
	total        INTEGER NOT NULL,
	created_at   INTEGER NOT NULL,
	voided_at    INTEGER
);

CREATE INDEX IF NOT EXISTS idx_sales_product_created ON sales(product_id, created_at);
CREATE INDEX IF NOT EXISTS idx_sales_created ON sales(created_at);
CREATE INDEX IF NOT EXISTS idx_sales_voided ON sales(voided_at);
`

// Open opens (and creates if needed) the SQLite file at path, turns on
// WAL mode, a busy timeout, and foreign keys, ensures the schema
// exists, and runs any pending migrations (see migrate.go). backupDir
// is where a safety backup is written before migrating an existing
// database; it's unused for a brand-new database.
func Open(path, backupDir string) (*sql.DB, error) {
	// "_pragma" query params apply SQLite settings as each connection opens.
	dsn := fmt.Sprintf(
		"%s?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)&_pragma=foreign_keys(1)",
		path,
	)
	conn, err := sql.Open("sqlite", dsn)
	if err != nil {
		return nil, fmt.Errorf("open db: %w", err)
	}
	if err := conn.Ping(); err != nil {
		return nil, fmt.Errorf("ping db: %w", err)
	}
	// SQLite only allows one writer at a time; a single connection avoids
	// "database is locked" errors and also means two concurrent requests
	// are naturally serialized by the Go connection pool.
	conn.SetMaxOpenConns(1)

	hadTables, err := tableExists(conn, "products")
	if err != nil {
		return nil, fmt.Errorf("check schema: %w", err)
	}

	if _, err := conn.Exec(baseSchema); err != nil {
		return nil, fmt.Errorf("apply schema: %w", err)
	}

	if err := migrate(conn, backupDir, hadTables); err != nil {
		return nil, fmt.Errorf("migrate: %w", err)
	}

	return conn, nil
}

func tableExists(conn *sql.DB, name string) (bool, error) {
	var n int
	err := conn.QueryRow(`SELECT count(*) FROM sqlite_master WHERE type = 'table' AND name = ?`, name).Scan(&n)
	if err != nil {
		return false, err
	}
	return n > 0, nil
}
